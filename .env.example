# ============================================================
# CutPoint — example environment file
# Copy to .env (backend) / .env.local (frontend) and fill in.
# NEVER commit real secrets. .env files are gitignored.
# ============================================================

# ---- Database (local Docker Postgres, see docker-compose.yml) ----
POSTGRES_USER=cutpoint
POSTGRES_PASSWORD=cutpoint
POSTGRES_DB=cutpoint
# SQLAlchemy/SQLModel async URL used by the backend:
DATABASE_URL=postgresql+psycopg://cutpoint:cutpoint@localhost:5432/cutpoint

# ---- Auth (self-hosted JWT) ----
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- LLM explanation layer (Groq) ----
# Leave blank to run rule-based fallback explanations (demo still works).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Realistic AI try-on (fal.ai, Flux Kontext) ----
# Leave blank to disable the realistic AI try-on (2D overlay still works).
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext

# ---- Email notifications (Gmail SMTP) ----
# Leave blank to disable emails (in-app status still updates).
# Use a Gmail App Password (Google Account → Security → App passwords),
# NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=CutPoint

# ---- Backend server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS (frontend dev server):
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) — these go in frontend/.env.local ----
# Base URL the browser uses to reach the FastAPI backend:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Ready Player Me subdomain for the 3D avatar creator (free, no API key).
# Create one at https://studio.readyplayer.me  → e.g. "cutpoint"
NEXT_PUBLIC_RPM_SUBDOMAIN=demo
